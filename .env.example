# ==============================================================================
# Finance Tracker - Production Environment Variables Template
# Copy this file to .env and replace with your secure production values.
# NEVER commit real production .env files to source control.
# ==============================================================================

# Node Environment ('production' | 'development' | 'test')
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/finance_tracker?schema=public

# Database Credentials (used by infra/compose/docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=finance_tracker

# Redis Cache & Message Queue
# Example: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# JWT Security Secrets (Must be at least 32 characters long, cryptographically random)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_32_characters

# Token Time-to-Live
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS Allowed Origins (Comma-separated list of allowed client origins)
# For production, set to your exact domain(s), e.g.:
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Optional S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_BUCKET=finance-tracker-receipts
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional Sentry Error Monitoring
SENTRY_DSN=

# Frontend Configuration (used during web build)
# Leave empty if deploying behind unified reverse proxy on same domain
# Set to full backend URL if deploying web separately (e.g. Vercel, Netlify)
VITE_API_URL=https://api.yourdomain.com

# Initial Administrator Credentials (provisioned on first boot if no admins exist)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
ADMIN_MOBILE=+919876543210

# Standard User Credentials (optional for initial user provisioning)
STANDARD_USER_EMAIL=user@yourdomain.com
STANDARD_USER_PASSWORD=your_secure_password_min_8_chars
