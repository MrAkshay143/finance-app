# Multi-stage Dockerfile for Web Frontend per Plan/architecture.md §9

# Stage 1: Builder
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install PNPM
RUN corepack enable && corepack prepare pnpm@11.13.0 --activate

# Copy root workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json ./

# Copy package.json of all packages and apps for layer caching
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-ui-tokens/package.json ./packages/shared-ui-tokens/
COPY packages/api-client/package.json ./packages/api-client/
COPY apps/backend/package.json ./apps/backend/
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source code of shared packages and web
COPY packages/shared-types ./packages/shared-types
COPY packages/shared-ui-tokens ./packages/shared-ui-tokens
COPY packages/api-client ./packages/api-client
COPY apps/web ./apps/web

# Build shared packages first
RUN pnpm --filter @finance/shared-types build
RUN pnpm --filter @finance/shared-ui-tokens build
RUN pnpm --filter @finance/api-client build

# Build web frontend
RUN pnpm --filter @finance/web build

# Stage 2: Production Nginx Server for Static Assets
FROM nginx:alpine AS runner

# Copy built static files from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy production Nginx configuration
COPY infra/nginx/nginx.prod.conf /etc/nginx/nginx.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
