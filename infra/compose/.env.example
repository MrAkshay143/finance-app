# Application Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/finance_tracker?schema=public

# Cache & Message Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Object Storage (MinIO / S3 Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=finance-tracker
S3_ENDPOINT=http://minio:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finance-tracker

# Authentication (JWT & Refresh Tokens)
JWT_ACCESS_SECRET=development-jwt-access-secret-minimum-32-chars-key
JWT_REFRESH_SECRET=development-jwt-refresh-secret-minimum-32-chars-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Client
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000
VITE_API_URL=http://localhost
