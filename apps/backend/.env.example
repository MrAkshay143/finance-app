# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth Secrets
JWT_ACCESS_SECRET="default_access_secret_for_dev_min_32_chars_12345"
JWT_REFRESH_SECRET="default_refresh_secret_for_dev_min_32_chars_12345"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Server
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# S3 / Object Storage (Optional for Dev)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Monitoring (Optional)
SENTRY_DSN=""
