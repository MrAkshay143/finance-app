# Frontend Environment Variables Example
# If deploying via reverse proxy (Docker/Nginx) on the same domain, leave VITE_API_URL empty to use relative /api/v1
# If deploying frontend separately (e.g. Vercel, Netlify, Cloudflare Pages, Hostinger), provide the backend URL:
VITE_API_URL="https://api.yourdomain.com"

# Optional: Realtime WebSocket server URL (defaults to VITE_API_URL or window.location.origin)
VITE_SOCKET_URL="https://api.yourdomain.com"
